# Copy this file to .env and fill in your actual values

# Environment Configuration
ENVIRONMENT=development

# Security - IMPORTANT: Change this to a strong random key in production
SECRET_KEY=your-super-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=7

# Database
# Local PostgreSQL for running the backend directly:
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_health
# PostgreSQL service name used inside docker-compose:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/ai_health
# Optional SQLite fallback for quick experiments:
# DATABASE_URL=sqlite:///./health.db

# docker-compose only: credentials for the db/grafana services it starts.
# Required — docker-compose refuses to start without these set.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ai_health
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me

# CORS - comma-separated list of allowed origins (use http:// for local development)
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000,http://localhost:8081,http://127.0.0.1:8000

# API Configuration
API_TITLE=Heallio API
LOG_LEVEL=INFO
SENTRY_DSN=
ENABLE_SCHEDULER=true
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=60
CHAT_RATE_LIMIT=40
CHAT_RATE_WINDOW_SECONDS=60
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CHAT_MAX_TOKENS=512
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300
